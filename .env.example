# Defaults work without this file. The backend loads ./.env or ../.env automatically on start;
# variables already set in the shell take precedence.
API_ADDR=127.0.0.1:8080
OPENFOOTBALL_LEAGUE=br.1
OPENFOOTBALL_SEASON=2026
# Série A history 2003–2024 from GitHub (adaoduque/Brasileirao_Dataset, GPL-2.0). Use off to disable.
BRASILEIRAO_HISTORY=on
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=240s
# Frontend: optionally put VITE_API_URL=http://127.0.0.1:8080 in frontend/.env.local.
# By default Vite proxies /api to the backend; no frontend env file is needed.
# Optional: per-match statistics (possession, shots, corners, fouls, cards) from API-Football.
# Free key at https://dashboard.api-football.com (100 requests/day). Scores still come from OpenFootball.
# API_FOOTBALL_KEY=

# Optional: match statistics from API-Futebol (https://dash.api-futebol.com.br/chaves-api).
# Takes precedence over API_FOOTBALL_KEY. Test keys (test_…) return sample data, labeled in the UI.
# API_FUTEBOL_KEY=

# Optional: PostgreSQL cache for API responses. Start it with: docker compose up -d
# Without DATABASE_URL, responses are cached in memory only (lost on restart).
POSTGRES_DB=matchmind
POSTGRES_USER=matchmind
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5435
# DATABASE_URL=postgres://matchmind:change-me@127.0.0.1:5435/matchmind?sslmode=disable

# Optional: AlmanacStats (free, keyless) for match statistics and squads. Its terms allow only
# personal, non-commercial use and restrict use with AI models; read README before enabling.
ALMANACSTATS=off
